PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret
CLIENT_URL=http://localhost:5173
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Password reset email via Resend (https://resend.com). Verify your sending domain for production.
RESEND_API_KEY=re_your_resend_api_key
SMTP_FROM=TravelInn <support@your-verified-domain.com>
